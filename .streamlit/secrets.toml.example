# Copy these values into Streamlit Cloud -> App settings -> Secrets.
# Do not commit real credentials.

DATABASE_URL = "postgresql://username:password@host:5432/solar_monitoring"
DB_HOST = "host"
DB_PORT = "5432"
DB_NAME = "solar_monitoring"
DB_USER = "username"
DB_PASSWORD = "password"

# Optional hosted AI endpoint. Localhost will not work from cloud hosting.
OLLAMA_BASE_URL = "https://your-hosted-ai-endpoint"
OLLAMA_MODEL = "qwen2.5:7b"
